#!/bin/sh
# The runner's command line from its release: cp-runner <comando> [opções].
# Runs ClaudeControlPlaneRunner.Main; see `cp-runner` with no command.
set -e

# Follow a symlink (e.g. ~/.local/bin/cp-runner) back to the release.
SELF="$0"
while [ -L "$SELF" ]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in
    /*) SELF="$TARGET" ;;
    *) SELF="$(dirname "$SELF")/$TARGET" ;;
  esac
done
RELEASE_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

exec "$RELEASE_ROOT/bin/claude_control_plane_runner" eval "ClaudeControlPlaneRunner.Main.main()" "$@"
