#!/bin/sh
# Stands in for `claude -p <prompt> --output-format stream-json ...` in tests:
# prints the same kind of lines a real run prints, without calling any model.
#
# The prompt steers it, so a test (or an e2e spec typing in the browser) picks
# the outcome:
#
#   a prompt with "[lento]" waits 30 s before finishing (to test canceling)
#   a prompt with "[falha]" writes to stderr and exits 1, unless it also has
#     "Tentar sem falha" (the answer to the analysis below) or it is an
#     analysis (whose prompt repeats the task's)
#   a prompt with "[bloqueio]" (and no "[desbloqueio]") answers status
#     "bloqueado" when asked for structured output
#   a prompt with "[perguntas]" (and no "[desbloqueio]") answers status
#     "bloqueado" with two structured questions: a single-choice one whose
#     recommended option has a preview, and a multiple-choice one
#   a prompt with "[digitando]" writes its answer in partial message lines
#     first, as `--include-partial-messages` does
#   a prompt with "[gotejando]" waits 3 s after the first tool result, then
#     runs one more tool (a Bash call and its result) before answering
#   a prompt with "[limite]" reports the account near its usage limits (a
#     five-hour window at 86%)
#
# A JSON Schema whose "$comment" is "pipemaestro-kind:<kind>" (a proposal,
# PipeMaestro.Proposals)
# gets that kind's fixed answer: a project and a two-stage pipeline
# ("pipeline"), a task ("task"), a decision to retry ("decision"), a
# diagnosis and one question whose recommended option is "Tentar sem falha"
# ("analysis"), or a revised pipeline with notes ("improve").
#
# Its lines have what a real run reports for auditing (session, tools, MCP
# servers, each message's id, model and tokens,
# the permission behind each tool call, the run's totals), and a warning on
# stderr. Given OTEL_EXPORTER_OTLP_ENDPOINT, it posts an OTLP export there
# (an API request with its origin, a tool result, an MCP server connection, a
# permission decision, a finished subagent, and the lines-of-code and
# active-time metrics) for the job in OTEL_RESOURCE_ATTRIBUTES, as the CLI's
# telemetry does.
#
# It writes the prompt to fake-claude.txt in the working directory, so a test
# can tell where it ran, and, like a pipeline stage, writes its artifact to
# $CP_ARTIFACT_PATH when that is set.

if [ "$1" = "--version" ]; then
  echo "0.0.0-fake (Claude Code)"
  exit 0
fi

prompt="$2"
printf '%s\n' "$prompt" > fake-claude.txt

structured=""
schema=""
next_is_schema=""
for arg in "$@"; do
  if [ -n "$next_is_schema" ]; then schema="$arg"; next_is_schema=""; fi
  if [ "$arg" = "--json-schema" ]; then structured=1; next_is_schema=1; fi
done
kind=$(printf '%s' "$schema" | sed -n 's/.*"\$comment":"pipemaestro-kind:\([a-z]*\)".*/\1/p')

echo "fake_claude: aviso de exemplo" >&2

echo '{"type":"system","subtype":"init","cwd":"'"$PWD"'","session_id":"fake-session","model":"fake-model","claude_code_version":"0.0.0-fake","apiKeySource":"none","permissionMode":"bypassPermissions","output_style":"default","tools":["Bash","Read","Write"],"mcp_servers":[{"name":"grafana","status":"connected"}],"agents":["Explore"],"skills":[],"slash_commands":["compact"],"plugins":[]}'
case "$prompt" in
  *"[limite]"*)
    echo '{"type":"rate_limit_event","rate_limit_info":{"status":"allowed_warning","rateLimitType":"five_hour","resetsAt":4102444800,"unifiedWindows":{"five_hour":{"utilization":0.86},"seven_day":{"utilization":0.31}}}}'
    ;;
esac
echo '{"type":"system","subtype":"thinking_tokens","estimated_tokens":10}'
echo '{"type":"assistant","thinking_duration_ms":420,"message":{"id":"msg_1","model":"fake-model","usage":{"input_tokens":5,"cache_read_input_tokens":1000,"cache_creation_input_tokens":200,"output_tokens":3},"content":[{"type":"thinking","thinking":""}]}}'
echo '{"type":"assistant","message":{"id":"msg_1","model":"fake-model","usage":{"input_tokens":5,"cache_read_input_tokens":1000,"cache_creation_input_tokens":200,"output_tokens":3},"content":[{"type":"tool_use","id":"toolu_1","name":"Write","input":{"file_path":"fake-claude.txt","content":"..."}}]}}'
echo '{"type":"user","tool_result_meta":[{"id":"toolu_1","permission_decision":{"decision":"accept","source":"config"}}],"message":{"content":[{"type":"tool_result","tool_use_id":"toolu_1","content":"File created successfully","is_error":false}]}}'

if [ -n "$OTEL_EXPORTER_OTLP_ENDPOINT" ]; then
  job_id="${OTEL_RESOURCE_ATTRIBUTES#cp.job_id=}"
  resource='{"attributes":[{"key":"cp.job_id","value":{"stringValue":"'"$job_id"'"}}]}'
  curl -s -o /dev/null -X POST -H 'content-type: application/json' "$OTEL_EXPORTER_OTLP_ENDPOINT/v1/logs" --data '{"resourceLogs":[{"resource":'"$resource"',"scopeLogs":[{"logRecords":[{"body":{"stringValue":"claude_code.api_request"},"attributes":[{"key":"event.timestamp","value":{"stringValue":"2026-11-03T12:00:00.000Z"}},{"key":"model","value":{"stringValue":"fake-model"}},{"key":"duration_ms","value":{"intValue":"900"}},{"key":"ttft_ms","value":{"intValue":"300"}},{"key":"input_tokens","value":{"intValue":"5"}},{"key":"output_tokens","value":{"intValue":"40"}},{"key":"cost_usd","value":{"doubleValue":0.0042}},{"key":"query_source","value":{"stringValue":"sdk"}}]},{"body":{"stringValue":"claude_code.mcp_server_connection"},"attributes":[{"key":"event.timestamp","value":{"stringValue":"2026-11-03T12:00:00.000Z"}},{"key":"status","value":{"stringValue":"connected"}},{"key":"transport_type","value":{"stringValue":"http"}},{"key":"server_scope","value":{"stringValue":"user"}},{"key":"duration_ms","value":{"stringValue":"120"}}]},{"body":{"stringValue":"claude_code.tool_decision"},"attributes":[{"key":"event.timestamp","value":{"stringValue":"2026-11-03T12:00:00.500Z"}},{"key":"decision","value":{"stringValue":"accept"}},{"key":"source","value":{"stringValue":"config"}},{"key":"tool_name","value":{"stringValue":"Write"}}]},{"body":{"stringValue":"claude_code.subagent_completed"},"attributes":[{"key":"event.timestamp","value":{"stringValue":"2026-11-03T12:00:00.800Z"}},{"key":"agent_type","value":{"stringValue":"Explore"}}]},{"body":{"stringValue":"claude_code.tool_result"},"attributes":[{"key":"event.timestamp","value":{"stringValue":"2026-11-03T12:00:01.000Z"}},{"key":"tool_name","value":{"stringValue":"Write"}},{"key":"tool_use_id","value":{"stringValue":"toolu_1"}},{"key":"success","value":{"stringValue":"true"}},{"key":"duration_ms","value":{"stringValue":"12"}}]}]}]}]}'
  curl -s -o /dev/null -X POST -H 'content-type: application/json' "$OTEL_EXPORTER_OTLP_ENDPOINT/v1/metrics" --data '{"resourceMetrics":[{"resource":'"$resource"',"scopeMetrics":[{"metrics":[{"name":"claude_code.lines_of_code.count","sum":{"dataPoints":[{"timeUnixNano":"1793750400000000000","asInt":"7","attributes":[{"key":"type","value":{"stringValue":"added"}}]}]}},{"name":"claude_code.active_time.total","sum":{"dataPoints":[{"timeUnixNano":"1793750400000000000","asDouble":12.5,"attributes":[{"key":"type","value":{"stringValue":"cli"}}]}]}}]}]}]}'
fi

case "$prompt" in
  *"[lento]"*) sleep 30 ;;
  *"[gotejando]"*)
    sleep 3
    echo '{"type":"assistant","message":{"id":"msg_3","model":"fake-model","usage":{"input_tokens":5,"cache_read_input_tokens":1000,"cache_creation_input_tokens":200,"output_tokens":3},"content":[{"type":"tool_use","id":"toolu_2","name":"Bash","input":{"command":"ls","description":"Lista o workdir"}}]}}'
    echo '{"type":"user","tool_result_meta":[{"id":"toolu_2","permission_decision":{"decision":"accept","source":"config"}}],"message":{"content":[{"type":"tool_result","tool_use_id":"toolu_2","content":"fake-claude.txt","is_error":false}]}}'
    ;;
esac

case "$prompt" in
  *"Tentar sem falha"*) ;;
  *"[falha]"*)
    if [ "$kind" != "analysis" ]; then
      echo "fake_claude: falha simulada" >&2
      exit 1
    fi
    ;;
esac

status="ok"
questions=""
summary="Etapa concluída pelo fake_claude."
case "$prompt" in
  *"[desbloqueio]"*) ;;
  *"[bloqueio]"*)
    status="bloqueado"
    summary="Preciso saber qual navegador reproduz o problema."
    ;;
  *"[perguntas]"*)
    status="bloqueado"
    summary="Preciso de duas respostas para seguir."
    questions='[{"titulo":"Navegador","pergunta":"Em qual navegador reproduz?","multipla":false,"opcoes":[{"rotulo":"Chrome","descricao":"O mais usado.","recomendada":false},{"rotulo":"Safari 17","descricao":"Onde o bug apareceu.","recomendada":true,"preview":"```js\nwindow.safari.open()\n```"}]},{"titulo":"Telas","pergunta":"Quais telas mudam?","multipla":true,"opcoes":[{"rotulo":"Board","descricao":"O quadro de tarefas.","recomendada":true},{"rotulo":"Decisões","descricao":"A página de decisões.","recomendada":false}]}]'
    ;;
esac

if [ -n "$CP_ARTIFACT_PATH" ] && [ "$status" = "ok" ]; then
  mkdir -p "$(dirname "$CP_ARTIFACT_PATH")"
  printf '# Artefato do fake_claude\n\n%s\n\n```elixir\ndef pronto?, do: true\n```\n' "$summary" > "$CP_ARTIFACT_PATH"
fi

case "$prompt" in
  *"[digitando]"*)
    for part in "Pronto: " "gravei o prompt " "em fake-claude.txt."; do
      echo '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"'"$part"'"}}}'
      sleep 0.3
    done
    ;;
esac

echo '{"type":"assistant","message":{"id":"msg_2","model":"fake-model","usage":{"input_tokens":2,"cache_read_input_tokens":1200,"cache_creation_input_tokens":0,"output_tokens":30},"content":[{"type":"text","text":"Pronto: gravei o prompt em fake-claude.txt."}]}}'

totals='"session_id":"fake-session","stop_reason":"end_turn","duration_api_ms":900,"ttft_ms":300,"usage":{"input_tokens":7,"cache_read_input_tokens":2200,"cache_creation_input_tokens":200,"output_tokens":33},"modelUsage":{"fake-model":{"inputTokens":7,"outputTokens":33,"cacheReadInputTokens":2200,"cacheCreationInputTokens":200,"costUSD":0.0042}},"permission_denials":[]'

if [ -n "$structured" ]; then
  output='{"status":"'"$status"'","resumo":"'"$summary"'"}'
  if [ -n "$questions" ]; then
    output='{"status":"'"$status"'","resumo":"'"$summary"'","perguntas":'"$questions"'}'
  fi
  case "$kind" in
    pipeline)
      output='{"analise":"Um app de exemplo do fake_claude. Os testes rodam com `make test`.","verificacoes":[{"comando":"make test","passou":true},{"comando":"make lint","passou":false,"observacao":"Sem alvo de lint no Makefile."}],"projeto":{"nome":"App do fake","setup":"make deps","teste":"make test","lint":"make lint","copy_paths":["deps"],"notas":"Rode `make test` antes de entregar."},"pipeline":{"name":"Entrega proposta","description":"Plano e implementação com testes.","delivery":"pr","stages":[{"key":"plano","name":"Plano","prompt":"Planeje a mudança: {{tarefa.descricao}}"},{"key":"implementacao","name":"Implementação","prompt":"Implemente o plano e rode {{projeto.teste}}.","gates":["{{projeto.teste}}"],"max_attempts":3}]}}'
      ;;
    task)
      output='{"analise":"O README do app descreve o login; o fake_claude leu o projeto.","titulo":"Destravar o login sob carga","descricao":"## Problema\n\nO login trava com muitos acessos.\n\n## Critérios de aceite\n\n- 100 logins simultâneos terminam em menos de 2 s.","pipeline":"Prompt único","pronta":true,"perguntas":[]}'
      ;;
    decision)
      output='{"diagnostico":"A etapa parou porque **falta saber o navegador**.","acao":"retry","instrucoes":"Considere o Chrome e siga. [desbloqueio]","alternativas":[{"acao":"cancel","motivo":"Se o problema não reproduzir em nenhum navegador."}]}'
      ;;
    analysis)
      output='{"diagnostico":"A etapa falhou porque o **fake_claude** simulou uma falha.","perguntas":[{"titulo":"Correção","pergunta":"Como a etapa deve seguir?","multipla":false,"opcoes":[{"rotulo":"Desistir","descricao":"Deixa a tarefa como está.","recomendada":false},{"rotulo":"Tentar sem falha","descricao":"Roda a etapa de novo sem a falha simulada.","recomendada":true}]}]}'
      ;;
    improve)
      output='{"analise":"A etapa única terminou bem; falta um gate de testes.","mudancas":[{"onde":"Etapa Executar","o_que":"Gate {{projeto.teste}}","por_que":"Nenhuma tarefa verificou os testes."}],"pipeline":{"name":"Prompt único","description":"Um prompt, com testes.","stages":[{"key":"executar","name":"Executar","prompt":"{{tarefa.descricao}}","gates":["{{projeto.teste}}"]}]},"notas":"Rode `make test` antes de entregar."}'
      ;;
  esac
  # printf, not echo: sh's echo would turn the answer's \n into newlines.
  printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"'"$(printf '%s' "$output" | sed 's/\\/\\\\/g; s/"/\\"/g')"'","structured_output":'"$output"',"total_cost_usd":0.0042,"duration_ms":1234,"num_turns":2,'"$totals"'}'
else
  echo '{"type":"result","subtype":"success","is_error":false,"result":"Pronto: gravei o prompt em fake-claude.txt.","total_cost_usd":0.0042,"duration_ms":1234,"num_turns":2,'"$totals"'}'
fi
